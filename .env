# --- Image versions (pin these for production) ---
EJBCA_VERSION=latest
MARIADB_VERSION=11.4

# --- Host settings ---
EJBCA_HOSTNAME=ejbca.local
HTTP_PORT=80
HTTPS_PORT=443

# --- TLS mode: true | simple | later ---
TLS_SETUP_ENABLED=true

# --- Database (CHANGE THESE PASSWORDS) ---
DB_NAME=ejbca
DB_USER=ejbca
DB_PASSWORD=change-me-ejbca
DB_ROOT_PASSWORD=change-me-root
